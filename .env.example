# Supabase public configuration. Copy this file to `.env.local` for local use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Keep only public, low-privilege values in NEXT_PUBLIC_* variables.
# Never add service_role keys, database passwords or other secrets here.
