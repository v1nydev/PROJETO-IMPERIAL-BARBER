# Supabase public configuration. Copy this file to `.env.local` for local use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never add a Supabase secret key to a NEXT_PUBLIC_* variable.
# Server-only credentials are intentionally not required in Etapa 13.
